{
  "schemaVersion": 1,
  "name": "multiprocess.held-beam-bidirectional",
  "seed": 71,
  "timeoutMs": 120000,
  "steps": [
    { "op": "wait.ready" },
    { "op": "assert.remoteVisible" },
    { "op": "held.spawn", "role": "host", "definition": "flashlight" },
    { "op": "held.pickup", "role": "host" },
    { "op": "held.power", "role": "host" },
    { "op": "assert.localHeldBeam", "role": "host" },
    { "op": "held.angle", "role": "host", "angle": 30 },
    { "op": "assert.remoteHeld", "role": "guest", "definition": "flashlight", "angle": 30, "tolerance": 3, "beam": true },
    { "op": "wait.peerStep" },
    { "op": "held.angle", "role": "host", "angle": 130 },
    { "op": "assert.remoteHeld", "role": "guest", "definition": "flashlight", "angle": 130, "tolerance": 3, "beam": true },
    { "op": "wait.peerStep" },
    { "op": "held.offer", "role": "host", "definition": "flashlight" },
    { "op": "held.findOffer", "role": "guest", "definition": "flashlight" },
    { "op": "held.pickup", "role": "guest" },
    { "op": "held.power", "role": "guest" },
    { "op": "assert.localHeldBeam", "role": "guest" },
    { "op": "held.angle", "role": "guest", "angle": 335 },
    { "op": "assert.remoteHeld", "role": "host", "definition": "flashlight", "angle": 335, "tolerance": 3, "beam": true },
    { "op": "wait.peerStep" },
    { "op": "held.angle", "role": "guest", "angle": 20 },
    { "op": "assert.remoteHeld", "role": "host", "definition": "flashlight", "angle": 20, "tolerance": 3, "wrapFrom": 335, "beam": true },
    { "op": "wait.peerStep" },
    { "op": "held.drop", "role": "guest" },
    { "op": "assert.heldBeamReleased", "role": "host" },
    { "op": "assert.isolation" },
    { "op": "wait.peerStep" }
  ]
}
