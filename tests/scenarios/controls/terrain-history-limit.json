{
  "schemaVersion": 1,
  "name": "control.terrain-history-limit",
  "level": "UNITY_HOST",
  "seed": 42,
  "timeoutMs": 75000,
  "network": {
    "latencyMs": 3
  },
  "setup": [
    {
      "op": "world.loadSandbox"
    },
    {
      "op": "peer.add",
      "id": "host",
      "role": "host"
    },
    {
      "op": "peer.add",
      "id": "guest",
      "role": "guest"
    },
    {
      "op": "world.loadLayout",
      "id": "history-last-tracked",
      "position": [
        33,
        64
      ],
      "rows": [
        "."
      ],
      "legend": {
        ".": 0
      }
    }
  ],
  "steps": [
    {
      "op": "wait.ready"
    },
    {
      "op": "peer.disconnect",
      "peer": "guest"
    },
    {
      "op": "control.terrainHistoryProbe",
      "position": [
        -30,
        1
      ]
    },
    {
      "op": "assert.equal",
      "query": "world.firstBlock",
      "target": "history-overflow",
      "expected": 0
    },
    {
      "op": "peer.reconnect",
      "peer": "guest"
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 14000,
      "condition": {
        "op": "terrain.guestsMatch",
        "target": "history-first",
        "expected": 1
      }
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 36000,
      "condition": {
        "op": "terrain.guestsMatch",
        "target": "history-last-tracked",
        "expected": 1
      }
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 3500,
      "condition": {
        "op": "terrain.guestsMatch",
        "target": "history-overflow",
        "expected": 1
      }
    }
  ]
}
