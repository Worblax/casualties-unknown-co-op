{
  "schemaVersion": 1,
  "name": "control.replica-condition-divergence",
  "level": "UNITY_HOST",
  "seed": 42,
  "timeoutMs": 45000,
  "network": {
    "latencyMs": 45,
    "jitterMs": 5
  },
  "setup": [
    {
      "op": "world.loadSandbox"
    },
    {
      "op": "peer.add",
      "id": "host",
      "role": "host"
    },
    {
      "op": "peer.add",
      "id": "alice",
      "role": "guest",
      "mode": "VirtualOnly",
      "position": [
        1,
        0
      ]
    },
    {
      "op": "item.spawn",
      "id": "target",
      "catalogId": "stick",
      "position": [
        0,
        0
      ]
    }
  ],
  "steps": [
    {
      "op": "wait.ready"
    },
    {
      "op": "item.pickup",
      "peer": "alice",
      "item": "target",
      "slot": "$fixture.emptyPickupSlot"
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 5000,
      "condition": {
        "op": "items.converged",
        "expected": 1,
        "item": "target"
      }
    },
    {
      "op": "control.divergeReplica",
      "peer": "alice",
      "item": "target"
    },
    {
      "op": "wait.frames",
      "count": 20
    },
    {
      "op": "assert.equal",
      "query": "items.replicated",
      "expected": 1,
      "item": "target"
    },
    {
      "op": "assert.equal",
      "query": "runtime.unhandledExceptions",
      "expected": 0
    }
  ]
}
