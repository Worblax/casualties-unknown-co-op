{
  "schemaVersion": 1,
  "name": "world.terrain-resync",
  "level": "UNITY_HOST",
  "seed": 42,
  "timeoutMs": 45000,
  "network": {
    "latencyMs": 45,
    "jitterMs": 5
  },
  "setup": [
    {
      "op": "world.loadSandbox"
    },
    {
      "op": "peer.add",
      "id": "host",
      "role": "host"
    },
    {
      "op": "peer.add",
      "id": "alice",
      "role": "guest",
      "mode": "VirtualOnly",
      "position": [
        1,
        0
      ]
    },
    {
      "op": "peer.add",
      "id": "bob",
      "role": "guest",
      "mode": "VirtualOnly",
      "position": [
        -1,
        0
      ]
    },
    {
      "op": "world.loadLayout",
      "id": "wall",
      "position": [
        3,
        2
      ],
      "rows": [
        "x"
      ],
      "legend": {
        ".": 0,
        "x": 1,
        "b": 42
      }
    }
  ],
  "steps": [
    {
      "op": "wait.ready"
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 11000,
      "condition": {
        "op": "terrain.syncRequests",
        "target": "bob",
        "expected": 2
      }
    },
    {
      "op": "peer.disconnect",
      "peer": "bob"
    },
    {
      "op": "terrain.hit",
      "peer": "alice",
      "target": "wall",
      "damage": 25
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 5000,
      "condition": {
        "op": "terrain.hostDamage",
        "expected": 25,
        "target": "wall"
      }
    },
    {
      "op": "assert.equal",
      "query": "terrain.guestsMatch",
      "expected": 0,
      "target": "wall"
    },
    {
      "op": "peer.reconnect",
      "peer": "bob"
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 9500,
      "condition": {
        "op": "terrain.guestsMatch",
        "expected": 1,
        "target": "wall"
      }
    },
    {
      "op": "snapshot.capture",
      "id": "after-terrain-replay"
    },
    {
      "op": "assert.equal",
      "query": "runtime.unhandledExceptions",
      "expected": 0
    }
  ]
}
