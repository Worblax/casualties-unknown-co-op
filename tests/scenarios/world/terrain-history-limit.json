{
  "schemaVersion": 1,
  "name": "world.terrain-history-limit",
  "level": "UNITY_HOST",
  "seed": 72,
  "timeoutMs": 75000,
  "network": {
    "latencyMs": 10
  },
  "setup": [
    {
      "op": "world.loadSandbox"
    },
    {
      "op": "peer.add",
      "id": "host",
      "role": "host"
    },
    {
      "op": "peer.add",
      "id": "guest",
      "role": "guest"
    },
    {
      "op": "world.loadLayout",
      "id": "history-last-covered",
      "position": [
        33,
        64
      ],
      "rows": [
        "."
      ],
      "legend": {
        ".": 0,
        "x": 1
      }
    }
  ],
  "steps": [
    {
      "op": "wait.ready"
    },
    {
      "op": "peer.disconnect",
      "peer": "guest"
    },
    {
      "op": "terrain.breakArea",
      "position": [
        -30,
        1
      ]
    },
    {
      "op": "assert.equal",
      "query": "world.firstBlock",
      "expected": 0,
      "target": "history-overflow"
    },
    {
      "op": "peer.move",
      "peer": "guest",
      "position": [
        -28,
        62
      ]
    },
    {
      "op": "peer.reconnect",
      "peer": "guest"
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "terrain.guestsMatch",
        "expected": 1,
        "target": "history-overflow"
      }
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "terrain.guestsMatch",
        "expected": 1,
        "target": "history-first"
      }
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "terrain.guestsMatch",
        "expected": 1,
        "target": "history-last-covered"
      }
    },
    {
      "op": "assert.equal",
      "query": "runtime.unhandledExceptions",
      "expected": 0
    }
  ]
}
