{
  "schemaVersion": 1,
  "name": "world.chunk-guest-restore",
  "level": "UNITY_GUEST",
  "seed": 72,
  "timeoutMs": 65000,
  "network": {
    "latencyMs": 35,
    "jitterMs": 7
  },
  "setup": [
    {
      "op": "world.loadSandbox"
    },
    {
      "op": "peer.add",
      "id": "host",
      "role": "host"
    },
    {
      "op": "peer.add",
      "id": "guest",
      "role": "guest"
    },
    {
      "op": "world.loadLayout",
      "id": "sample",
      "position": [
        3,
        2
      ],
      "rows": [
        "x"
      ],
      "legend": {
        ".": 0,
        "x": 1
      }
    }
  ],
  "steps": [
    {
      "op": "wait.ready"
    },
    {
      "op": "terrain.state",
      "target": "sample",
      "material": 0,
      "damage": 0,
      "liquid": 1
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "terrain.cellLiquid",
        "expected": 1,
        "target": "sample"
      }
    },
    {
      "op": "assert.equal",
      "query": "world.firstBlock",
      "expected": 0,
      "target": "sample"
    },
    {
      "op": "terrain.state",
      "target": "sample",
      "material": 1,
      "damage": 22,
      "liquid": 0
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "terrain.hostDamage",
        "expected": 22,
        "target": "sample"
      }
    },
    {
      "op": "assert.equal",
      "query": "world.firstBlock",
      "expected": 1,
      "target": "sample"
    },
    {
      "op": "assert.equal",
      "query": "terrain.cellLiquid",
      "expected": 0,
      "target": "sample"
    },
    {
      "op": "terrain.state",
      "target": "sample",
      "material": 3,
      "damage": 0,
      "liquid": 0
    },
    {
      "op": "assert.eventually",
      "timeoutMs": 8000,
      "condition": {
        "op": "world.firstBlock",
        "expected": 3,
        "target": "sample"
      }
    },
    {
      "op": "assert.equal",
      "query": "terrain.hostDamage",
      "expected": 0,
      "target": "sample"
    },
    {
      "op": "snapshot.capture",
      "id": "native-restore"
    },
    {
      "op": "assert.equal",
      "query": "runtime.unhandledExceptions",
      "expected": 0
    }
  ]
}
