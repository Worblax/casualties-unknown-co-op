{
  "schemaVersion": 1,
  "name": "items.craft-ingredient-state",
  "level": "UNITY_ACTORS",
  "seed": 160,
  "timeoutMs": 120000,
  "network": { "latencyMs": 20, "jitterMs": 2, "unreliableLoss": 0 },
  "setup": [
    { "op": "world.loadSandbox" },
    { "op": "peer.add", "id": "host", "role": "host" },
    { "op": "character.spawn", "id": "left", "character": 0, "position": [-3, 0] },
    { "op": "character.intelligence", "target": "left", "value": 20 },
    { "op": "peer.add", "id": "alice", "role": "guest", "mode": "NativeActor", "body": "left" },
    { "op": "item.spawn", "id": "ropeA", "catalogId": "rope", "position": [-3.6, 0.5] },
    { "op": "item.spawn", "id": "ropeB", "catalogId": "rope", "position": [-3.3, 0.7] },
    { "op": "item.spawn", "id": "knife", "catalogId": "flimsyknife", "position": [-2.7, 0.6] }
  ],
  "steps": [
    { "op": "wait.ready" },
    { "op": "item.condition", "item": "knife", "condition": 1 },
    { "op": "item.pickup", "peer": "alice", "item": "ropeA", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.hostSlotMatchesClient", "actor": "alice", "target": "ropeA" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "ropeA" } },
    { "op": "item.swap", "peer": "alice", "item": "ropeA", "slot": 1 },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.hostSlotMatchesClient", "actor": "alice", "target": "ropeA" } },
    { "op": "item.pickup", "peer": "alice", "item": "ropeB", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.hostSlotMatchesClient", "actor": "alice", "target": "ropeB" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "ropeB" } },
    { "op": "item.swap", "peer": "alice", "item": "ropeB", "slot": 2 },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.hostSlotMatchesClient", "actor": "alice", "target": "ropeB" } },
    { "op": "item.pickup", "peer": "alice", "item": "knife", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.hostSlotMatchesClient", "actor": "alice", "target": "knife" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "knife" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "ropeA", "expected": 1 } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "ropeB", "expected": 1 } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "knife", "expected": 1 } },
    { "op": "assert.equal", "query": "items.hostCondition", "item": "knife", "expected": 100 },
    { "op": "assert.equal", "query": "items.hostNativeCondition", "item": "knife", "expected": 100 },

    { "op": "craft.fault", "point": "apply-first-ingredient" },
    { "op": "item.craft", "peer": "alice", "recipe": 2 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.lastCraftCompletion", "target": "alice", "expected": 6 },
    { "op": "assert.equal", "query": "items.lastCraftDecision", "expected": 2 },
    { "op": "assert.equal", "query": "items.hostCondition", "item": "knife", "expected": 100 },
    { "op": "assert.equal", "query": "items.hostNativeCondition", "item": "knife", "expected": 100 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 2 },

    { "op": "item.craft", "peer": "alice", "recipe": 2 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.lastCraftCompletion", "target": "alice", "expected": 5 },
    { "op": "assert.equal", "query": "items.lastCraftDecision", "expected": 1 },
    { "op": "assert.equal", "query": "items.hostCondition", "item": "knife", "expected": 88 },
    { "op": "assert.equal", "query": "items.hostNativeCondition", "item": "knife", "expected": 88 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "string", "expected": 3 },
    { "op": "assert.equal", "query": "runtime.unhandledExceptions", "expected": 0 }
  ]
}
