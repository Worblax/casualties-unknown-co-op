{
  "schemaVersion": 1,
  "name": "items.universal-state-transfer",
  "level": "UNITY_HOST",
  "seed": 141,
  "timeoutMs": 90000,
  "network": { "latencyMs": 25, "jitterMs": 5, "unreliableLoss": 0.05 },
  "setup": [
    { "op": "world.loadSandbox" },
    { "op": "peer.add", "id": "host", "role": "host" },
    { "op": "peer.add", "id": "alice", "role": "guest", "position": [1, 0] },
    { "op": "peer.add", "id": "bob", "role": "guest", "position": [-1, 0] },
    { "op": "item.spawn", "id": "lamp", "catalogId": "flashlight", "position": [0, 0] },
    { "op": "item.spawn", "id": "pistolItem", "catalogId": "pistol", "position": [0.4, 0] },
    { "op": "item.spawn", "id": "bottle", "catalogId": "waterbottle", "position": [0.8, 0] }
  ],
  "steps": [
    { "op": "wait.ready" },
    { "op": "item.condition", "item": "lamp", "condition": 0.37 },
    { "op": "item.wet", "item": "lamp", "wet": true },
    { "op": "item.gun", "item": "pistolItem", "rounds": 7, "chamber": 1, "hasMag": true, "safe": false, "racked": true },
    { "op": "item.liquid", "item": "bottle", "liquid": "water", "amount": 250, "clear": true },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "lamp" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "pistolItem" } },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.replicaPayloadMatches", "item": "bottle" } },
    { "op": "assert.equal", "query": "items.hostCondition", "item": "lamp", "expected": 37 },
    { "op": "assert.equal", "query": "items.hostWet", "item": "lamp", "expected": 1 },
    { "op": "assert.equal", "query": "items.hostGunRounds", "item": "pistolItem", "expected": 7 },
    { "op": "assert.equal", "query": "items.hostLiquidMl", "item": "bottle", "expected": 250 },
    { "op": "item.pickup", "peer": "alice", "item": "lamp", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "lamp" } },
    { "op": "item.drop", "peer": "alice", "item": "lamp" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.unownedConverged", "item": "lamp" } },
    { "op": "item.pickup", "peer": "bob", "item": "lamp", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "lamp" } },
    { "op": "item.drop", "peer": "bob", "item": "lamp" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.unownedConverged", "item": "lamp" } },
    { "op": "item.pickup", "peer": "alice", "item": "lamp", "slot": "$fixture.emptyPickupSlot" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.converged", "item": "lamp" } },
    { "op": "item.drop", "peer": "alice", "item": "lamp" },
    { "op": "assert.eventually", "timeoutMs": 10000, "condition": { "op": "items.unownedConverged", "item": "lamp" } },
    { "op": "assert.equal", "query": "items.hostCondition", "item": "lamp", "expected": 37 },
    { "op": "assert.equal", "query": "runtime.unhandledExceptions", "expected": 0 }
  ]
}
