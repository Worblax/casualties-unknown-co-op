{
  "schemaVersion": 1,
  "name": "items.craft-fault-injection",
  "level": "UNITY_ACTORS",
  "seed": 156,
  "timeoutMs": 180000,
  "network": { "latencyMs": 20, "jitterMs": 2, "unreliableLoss": 0 },
  "setup": [
    { "op": "world.loadSandbox" },
    { "op": "peer.add", "id": "host", "role": "host" },
    { "op": "character.spawn", "id": "left", "character": 0, "position": [-3, 0] },
    { "op": "character.intelligence", "target": "left", "value": 5 },
    { "op": "peer.add", "id": "alice", "role": "guest", "mode": "NativeActor", "body": "left" },
    { "op": "item.spawn", "id": "fernA", "catalogId": "foliage", "position": [-0.6, 0.5] },
    { "op": "item.spawn", "id": "fernB", "catalogId": "foliage", "position": [0.6, 0.5] }
  ],
  "steps": [
    { "op": "wait.ready" },
    { "op": "character.place", "target": "left", "position": [0, 0] },

    { "op": "craft.fault", "point": "vanilla-spawn-result" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },
    { "op": "assert.eventually", "timeoutMs": 5000, "condition": { "op": "items.hostNativeDefinitionCount", "target": "foliage", "expected": 2 } },

    { "op": "craft.fault", "point": "prepare-result" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "apply-first-ingredient" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "apply-second-ingredient" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "apply-result" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "bind-id" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "register-result" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "confirm-start" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "confirm-placement" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 2 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 0 },

    { "op": "craft.fault", "point": "finalize-destroy" },
    { "op": "item.craft", "peer": "alice", "recipe": 0 },
    { "op": "assert.eventually", "timeoutMs": 15000, "condition": { "op": "items.craftPending", "target": "alice", "expected": 0 } },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "foliage", "expected": 0 },
    { "op": "assert.equal", "query": "items.authoritativeDefinitionCount", "target": "rope", "expected": 1 },
    { "op": "items.auditNatives" },
    { "op": "assert.eventually", "timeoutMs": 5000, "condition": { "op": "items.hostNativeDefinitionCount", "target": "foliage", "expected": 0 } },
    { "op": "assert.eventually", "timeoutMs": 5000, "condition": { "op": "items.hostNativeDefinitionCount", "target": "rope", "expected": 1 } },
    { "op": "assert.equal", "query": "runtime.unhandledExceptions", "expected": 0 }
  ]
}


